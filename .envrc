# Manual reload: entering this directory should not kick off a long nix evaluation.
# After changing flake.nix / flake.lock / package.nix, run:  direnv reload
nix_direnv_manual_reload

# This project's own devel shell - NOT upstream github:mc-rtc/nixpkgs, which would give
# stock mc_rtc and no KinovaBotaPlate. This one carries the mc-rtc-safe-rl-qp stack:
# bastien-muraccioli's mc_rtc / Tasks / tvm / state-observation forks (the Acc-CBF-QP
# superbuild core), mc-kinova@main, and mc_mujoco + kinova_mj_description@main-external-forces
# for simulation. Its shellHook generates .superbuild/mc_rtc.yaml with $INSTALL_DIR ahead of
# the nix store paths, so locally-built robot modules/plugins/controllers shadow the nix ones.
#
# ../dev-overrides.sh (untracked, machine-local) points the mc_rtc / mc_kinova / ... inputs at
# the sibling checkouts so local edits to those take effect on `direnv reload`. If it is absent
# — e.g. a fresh clone elsewhere — MC_RTC_SAFE_RL_QP_DEV_OVERRIDES is empty and this falls back
# to the pinned sources.
#
# Note the variable: dev-overrides.sh emits one set of flags PER STACK. MC_RTC_DEV_OVERRIDES is
# the mc-rtc-kinova-external-forces one and names inputs this flake does not declare, and
# `--override-input` on an undeclared input is a hard error — so this project must use the
# safe-rl-qp variable and nothing else.
source_env_if_exists ../dev-overrides.sh

# nix-direnv cannot see the override flags. Its cache key is sha1 of the flake *attr* alone
# (direnvrc: profile="...flake-profile$(_nix_argsum_suffix "$flake_expr")"), so changing
# MC_RTC_SAFE_RL_QP_DEV_OVERRIDES never yields a new cache entry; and it `touch`es the profile on every
# successful load, so the mtime check against ../dev-overrides.sh can never fire either. The
# result is silent: the shell keeps serving the mc_rtc from whenever the cache was first built
# — including MC_RTC_BIN, LD_LIBRARY_PATH and the module paths — while `nix build` uses the
# overridden one. Mixing those two ABIs is a debugging nightmare. Stamp the flags and drop the
# cache ourselves when they change; manual-reload mode then asks for an explicit reload.
#
# The stamp covers the override flags AND a content fingerprint of the checkouts they point at
# (see ../dev-overrides.sh). The flags alone are not enough: editing mc-rtc-safe-rl-qp/flake.nix
# or one of its pkgs/*.nix leaves the flags byte-identical and touches none of the watch_file
# targets below, so without the fingerprint direnv keeps serving a profile built from the
# pre-edit sources and even `direnv reload` does not notice. That failure is silent and looks
# like the packaging change simply having no effect.
#
# The `$(...)` wrapper is load-bearing: the fingerprint is a newline-terminated list, and the
# `$(cat ...)` on the comparison side strips trailing newlines. Without it the two sides can
# never be equal, so every single load would delete the profile and the shell would end up with
# no flake environment at all (INSTALL_DIR, cmakeFlags and PATH all unset) until the next
# explicit nix-direnv-reload. Command substitution strips the trailing newline from both sides.
_ovr_stamp="$(direnv_layout_dir)/dev-overrides.stamp"
_ovr_value="$(printf '%s\n%s' "$MC_RTC_SAFE_RL_QP_DEV_OVERRIDES" \
                              "$MC_RTC_SAFE_RL_QP_DEV_OVERRIDES_FINGERPRINT")"
mkdir -p "$(direnv_layout_dir)"
if [ "$(cat "$_ovr_stamp" 2>/dev/null)" != "$_ovr_value" ]; then
  rm -f "$(direnv_layout_dir)"/flake-profile-*
  printf '%s' "$_ovr_value" >"$_ovr_stamp"
fi
unset _ovr_stamp _ovr_value

# shellcheck disable=SC2086  # MC_RTC_SAFE_RL_QP_DEV_OVERRIDES must word-split into separate nix flags
use flake .#mc-rtc-superbuild-RLKinovaBallBalancingMcController-devel \
  --no-write-lock-file $MC_RTC_SAFE_RL_QP_DEV_OVERRIDES

# package.nix defines the devel/runtime component lists that shape the shell, so edits to it
# must invalidate direnv's cache as well (use_flake only watches flake.nix and flake.lock).
watch_file package.nix
watch_file ../dev-overrides.sh

# The README suggests a `cmake_local` alias, but direnv only propagates environment
# variables - shell aliases and functions defined in .envrc are silently dropped. Export the
# flags instead and use them as:
#   cmake -B build $CMAKE_LOCAL_FLAGS -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR
export CMAKE_LOCAL_FLAGS="-DCMAKE_PREFIX_PATH=$PWD/.superbuild/install -DMC_RTC_HONOR_INSTALL_PREFIX=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -G Ninja"

# The superbuild shellHook hardcodes MC_RTC_BIN/MC_RTC_PATH to the *nix store* mc-rtc, and only
# prepends $INSTALL_DIR to LD_LIBRARY_PATH. When mc_rtc itself is built locally, its binaries
# and cmake config must win too, otherwise you get store tools driving locally-built libraries.
PATH_add "$PWD/.superbuild/install/bin"

# nixpkgs stages dependency prefixes in NIXPKGS_CMAKE_PREFIX_PATH and only copies them into
# CMAKE_PREFIX_PATH inside cmakeConfigurePhase, which never runs in a dev shell — so
# CMAKE_PREFIX_PATH is empty here. $INSTALL_DIR goes first so a locally-built mc_rtc wins over
# the store copy.
export CMAKE_PREFIX_PATH="$PWD/.superbuild/install${NIXPKGS_CMAKE_PREFIX_PATH:+:$NIXPKGS_CMAKE_PREFIX_PATH}"

# CMAKE_PREFIX_PATH alone is not enough to build mc_rtc from source. Several packages in this
# stack export CMake targets with no INTERFACE_INCLUDE_DIRECTORIES at all — state-observation is
# the one that bites first — so consumers never learn where their headers live. A nix *build*
# gets away with it because the cc-wrapper injects -isystem for every buildInput via
# NIX_CFLAGS_COMPILE; the superbuild shellHook clears that variable (deliberately: it stops
# store mc_rtc headers from shadowing locally-built ones). Rebuild the flags here from the
# staged prefixes, skipping mc-rtc itself so that shadowing protection is preserved. Without
# this, mc_rtc fails at
#   fatal error: state-observation/dynamics-estimators/lipm-dcm-estimator.hpp: No such file
_mcrtc_inc=""
for _p in ${NIXPKGS_CMAKE_PREFIX_PATH//:/ }; do
  case "$_p" in *-mc-rtc-2*) continue ;; esac
  [ -d "$_p/include" ] && _mcrtc_inc="$_mcrtc_inc -isystem $_p/include"
done
export NIX_CFLAGS_COMPILE="$_mcrtc_inc"
unset _mcrtc_inc _p
